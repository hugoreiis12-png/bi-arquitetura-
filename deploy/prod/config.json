{
  "environment": "prod",
  "workspaceId": "${PBI_WORKSPACE_ID}",
  "workspaceName": "${PBI_WORKSPACE_NAME}",
  "datasetName": "Vendas",
  "servicePrincipalId": "${PBI_SP_PROD_CLIENT_ID}",
  "isolation": {
    "mode": "rls+build",
    "scope": "dataset-suffix",
    "note": "Workspace unico dinamico por projeto conectado; desvio por branch/sufixo no commit. Sem workspace por ambiente (derroga ADR-002)."
  },
  "refreshPolicy": {
    "type": "scheduled",
    "schedule": "0 6 * * *",
    "maxRetries": 5
  },
  "approvers": [
    "steward-dados@empresa.com",
    "gerente-bi@empresa.com"
  ],
  "alerts": {
    "teams": "https://outlook.office.com/webhook/PLACEHOLDER",
    "emailOnFailure": [
      "oncall-bi@empresa.com",
      "steward-dados@empresa.com",
      "gerente-bi@empresa.com"
    ]
  }
}
