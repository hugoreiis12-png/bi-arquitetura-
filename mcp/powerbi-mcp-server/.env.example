# ============ Server ============
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ============ Azure AD / Power BI ============
AZURE_TENANT_ID=your-tenant-id
PBI_SP_CLIENT_ID=your-sp-client-id
PBI_SP_CLIENT_SECRET=your-sp-secret
PBI_AUTHORITY=https://login.microsoftonline.com
PBI_API_BASE=https://api.powerbi.com
PBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# ============ Workspaces ============
WORKSPACE_DEV_ID=
WORKSPACE_TEST_ID=
WORKSPACE_PROD_ID=
WORKSPACE_PLAYGROUND_ID=

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true

# ============ Approval ============
APPROVAL_TOKEN_TTL_MINUTES=15
REQUIRE_TWO_APPROVERS_FOR_PROD=true

# ============ Cost Limits ============
COST_LIMIT_DAILY_USD=50.0
COST_LIMIT_PER_USER_DAILY_USD=10.0
AUTO_PAUSE_ON_COST_LIMIT=true

# ============ Audit & DLP ============
AUDIT_LOG_RETENTION_DAYS=2555
DLP_ENABLED=true
DLP_BYPASS_ROLES=["BI-AI-Admin"]

# ============ Knowledge (RAG) ============
AI_SEARCH_ENDPOINT=
AI_SEARCH_API_KEY=
AI_SEARCH_INDEX_NAME=bi-knowledge

# ============ Observability ============
APP_INSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=powerbi-mcp
OTEL_SAMPLING_RATE=1.0

# ============ Sandbox ============
SANDBOX_MAX_ROWS=10000
SANDBOX_QUERY_TIMEOUT_SECONDS=30

# ============ Paths ============
BI_TEMPLATE_REPO=https://github.com/org/bi-template
REPOS_BASE_PATH=/tmp/bi-repos
