{
  "//": "MCP server configuration for VSCode (Cline/Continue).",
  "//": "Configure o cliente MCP que você usa. Suportados: Cline, Continue, Claude Desktop.",
  "//": "Veja: https://modelcontextprotocol.io/clients",
  "mcpServers": {
    "dax-staff-local": {
      "type": "stdio",
      "command": "node",
      "args": [
        "//192.168.0.250/elton/_NIO/Atividade_do_dia/bi-ide-architecture/build/index.js"
      ],
      "env": {
        "PYTHON_BIN": "py",
        "PBI_MODELING_MCP_ACCEPT_EULA": "true"
      }
    },
    "powerbi-authoring-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/powerbi-modeling-mcp@0.5.0-beta.13",
        "--start"
      ],
      "env": {
        "PBI_MODELING_MCP_ACCEPT_EULA": "true"
      }
    }
  }
}
